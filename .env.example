# Copy to .env (or export in your shell) before running.
# Get a key at https://console.anthropic.com/ — or skip this and run
# `ant auth login` instead; the SDK picks up the profile automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the analysis model (defaults to claude-opus-5)
# DECODER_MODEL=claude-opus-5

# Optional: NCBI API key raises PubMed rate limits from 3 to 10 req/s
# NCBI_API_KEY=
